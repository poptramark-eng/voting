# Copy this file to .env.local for local development.
# Do not commit .env.local or put server secrets in NEXT_PUBLIC_* variables.

# Auth0 Regular Web Application (SDK v4)
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Set this to the exact public origin used for this environment.
APP_BASE_URL=http://localhost:3000

# Supabase: public URL and publishable key. Database RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service-role key. Used by the invitation outbox worker and restricted billing code.
# NEVER expose this in browser code or rename it to NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email delivery (Resend). Use a sending-only API key restricted to poptraworld.digital.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Voting Platform <notifications@poptraworld.digital>"
CRON_SECRET=

# Optional platform billing integration. Use Paystack TEST credentials first.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional previous signing secret during a deliberate signing-secret rotation.
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=

# JSON object keyed by internal price code. Example only; not an approved price:
# {"org-monthly":{"amountMinor":10000,"currency":"KES","description":"Example monthly plan"}}
# amountMinor is in the currency's smallest unit (KES cents).
PAYSTACK_PRICE_CATALOG_JSON=

# Random secret protecting internal cron/worker endpoints (shared across workers).
